{
  "name": "gamejam-the-chair",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "replay:check": "node scripts/replay-check.mjs",
    "golden:update": "node scripts/golden-update.mjs",
    "route:update": "node scripts/route-update.mjs",
    "lint": "eslint src/game",
    "test:fast": "node scripts/test-fast.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@thorvg/webcanvas": "1.1.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "^6.4.1"
  }
}
